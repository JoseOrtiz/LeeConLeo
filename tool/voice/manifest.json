      "promptId": "syllables.meet.intro",
      "index": 0,
      "text": "¡Las letras se juntan para sonar! Escucha y toca.",
      "file": "assets/audio/prompts/syllables.meet.intro.0.m4a"
    },
    {
      "promptId": "syllables.trace.intro",
      "index": 0,
      "text": "¡Ahora escribamos las letras juntas! Pon tu dedo en el punto que brilla y sigue el camino.",
